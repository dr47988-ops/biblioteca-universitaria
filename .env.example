# Configuracion de PostgreSQL
DATABASE_URL=postgresql://USUARIO:CONTRASENA@SERVIDOR:5432/BASE_DE_DATOS

# Puerto del servidor
PORT=3000

# Entorno de ejecucion
NODE_ENV=development

# Clave secreta de sesiones (reemplazar por una clave larga y aleatoria)
SESSION_SECRET=CAMBIAR_POR_UNA_CLAVE_SEGURA

# Cuentas para pruebas automatizadas de permisos (opcional)
# Si se dejan vacias, esas pruebas se omiten.
TEST_ADMIN_CORREO=
TEST_ADMIN_CONTRASENA=
TEST_AUDITOR_CORREO=
TEST_AUDITOR_CONTRASENA=
TEST_BIBLIOTECARIO_CORREO=
TEST_BIBLIOTECARIO_CONTRASENA=
