{
  "name": "biblioteca-universitaria",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.3",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Reporte de pruebas de seguridad - Biblioteca Universitaria",
          "outputPath": "reports/reporte-pruebas-seguridad.html",
          "includeFailureMsg": true,
          "includeSuiteFailure": true,
          "dateFormat": "dd/mm/yyyy HH:MM:ss",
          "sort": "status"
        }
      ],
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "reporte-pruebas-seguridad.xml",
          "suiteName": "Pruebas de seguridad - Biblioteca Universitaria"
        }
      ]
    ],
    "setupFiles": [
      "<rootDir>/tests/helpers/configuracion.js"
    ]
  }
}
